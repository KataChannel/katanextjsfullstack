// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Menu Items
model Menu {
  id        String   @id @default(uuid())
  label     String   // Tên hiển thị menu
  url       String   // URL path
  icon      String?  // Icon name (lucide-react)
  order     Int      @default(0) // Thứ tự hiển thị
  published Boolean  @default(true) // Hiện/ẩn menu
  parentId  String?  // Parent menu ID (cho submenu)
  
  // Self-relation cho submenu
  parent   Menu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Menu[] @relation("MenuHierarchy")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menus")
  @@index([order])
  @@index([published])
  @@index([parentId])
}

// Menu Permissions - must be before User due to relation
model MenuPermission {
  id              String   @id @default(uuid())
  userId          String
  allowedMenus    Json     // Array of menu URLs user can access: ["/nlp", "/khoa-hoc"]
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@map("menu_permissions")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  password      String?   // Hashed password (nullable for OAuth users)
  role          String    @default("user") // user, editor, manager, admin
  emailVerified DateTime? // Email verification timestamp
  image         String?   // Profile image URL
  
  // OTP for verification
  otp           String?
  otpExpiresAt  DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  pages    Page[]
  accounts Account[]
  sessions Session[]
  menuPermissions MenuPermission[]

  @@map("users")
}

// OAuth accounts (Google, Facebook, etc.)
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String  // oauth, email, credentials
  provider          String  // google, facebook, credentials
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// User sessions
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Email verification and password reset tokens
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String   // email or user id
  token      String   @unique
  type       String   // email_verification, password_reset
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String?
  excerpt     String?
  published   Boolean  @default(false)
  
  // Page Builder JSON
  blocks      Json?
  
  // SEO Fields
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  ogType          String?  @default("article")
  canonicalUrl    String?
  
  // Layout Options
  showHeader Boolean @default(true)
  showFooter Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  @@map("posts")
  @@index([slug])
  @@index([published])
}

model Page {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String?  @db.Text
  published   Boolean  @default(false)
  
  // Page Builder JSON
  blocks      Json?
  
  // SEO Fields
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  ogType          String?  @default("website")
  canonicalUrl    String?
  
  // Layout Options
  showHeader Boolean @default(true)
  showFooter Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  @@map("pages")
  @@index([slug])
  @@index([published])
}

model SeoSettings {
  id              String   @id @default(uuid())
  domain          String   @unique
  siteName        String
  siteDescription String?
  defaultOgImage  String?
  twitterHandle   String?
  googleAnalytics String?
  googleTagManager String?
  facebookPixel   String?
  
  // Homepage Settings
  homePageType String? // 'page' | 'post' | null (default static homepage)
  homePageId   String? // ID of page or post to use as homepage
  
  // Structured Data
  organizationSchema Json?
  websiteSchema      Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_settings")
}

model WebsiteSettings {
  id              String   @id @default(uuid())
  domain          String   @unique
  
  // Header Settings
  logo            String?
  logoAlt         String?
  headerHtml      String?  @db.Text
  navigationMenu  Json?    // Array of menu items: [{label, url, children}]
  
  // Footer Settings
  footerHtml      String?  @db.Text
  footerText      String?
  socialLinks     Json?    // Array: [{platform, url, icon}]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("website_settings")
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  alt       String?
  caption   String?
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}
