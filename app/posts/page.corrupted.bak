          <div className="max-w-3xl mx-auto text-center space-y-4">                </p>

            <h1 className="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">                <Button asChild variant="outline">

              Blog làm đẹp                  <Link href="/users">Tạo User trước</Link>

            </h1>                </Button>

            <p className="text-base sm:text-lg text-muted-foreground">              </div>

              Cập nhật kiến thức chăm sóc sắc đẹp, xu hướng làm đẹp và tips từ chuyên gia            ) : (

            </p>              <CreatePostForm users={users} />

            <Badge variant="secondary" className="mt-4">            )}

              {posts.length} bài viết          </CardContent>

            </Badge>        </Card>

          </div>

        </div>        <Card>

      </section>          <CardHeader>

            <CardTitle>Danh sách Posts ({posts.length})</CardTitle>

      {/* Blog List */}            <CardDescription>

      <section className="py-12 sm:py-16 lg:py-20">              Tất cả bài viết trong hệ thống

        <div className="container mx-auto px-4 sm:px-6 lg:px-8">            </CardDescription>

          {posts.length === 0 ? (          </CardHeader>

            <Card>          <CardContent>

              <CardContent className="py-16 text-center space-y-4">            {posts.length === 0 ? (

                <p className="text-lg text-muted-foreground">              <p className="text-muted-foreground text-center py-8">

                  Chưa có bài viết nào được xuất bản.                Chưa có bài viết nào. Hãy tạo bài viết đầu tiên!

                </p>              </p>

                <Button variant="outline" asChild>            ) : (

                  <Link href="/">Về trang chủ</Link>              <div className="space-y-4">

                </Button>                {posts.map((post) => (

              </CardContent>                  <div 

            </Card>                    key={post.id} 

          ) : (                    className="p-4 border rounded-lg space-y-3"

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">                  >

              {posts.map((post) => (                    <div className="flex justify-between items-start">

                <Card                       <div className="flex-1">

                  key={post.id}                         <h3 className="font-semibold line-clamp-2">

                  className="flex flex-col hover:shadow-xl transition-all duration-300 group"                          {post.title}

                >                        </h3>

                  <CardHeader className="space-y-3">                        <p className="text-sm text-muted-foreground mt-1">

                    {/* Meta Info */}                          bởi {post.author.name || post.author.email}

                    <div className="flex items-center gap-4 text-xs text-muted-foreground">                        </p>

                      <div className="flex items-center gap-1">                      </div>

                        <Clock className="h-3 w-3" />                      <div className="flex items-center gap-2">

                        <time dateTime={post.createdAt.toISOString()}>                        <span className={`text-xs px-2 py-1 rounded ${

                          {new Date(post.createdAt).toLocaleDateString('vi-VN', {                          post.published 

                            year: 'numeric',                            ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' 

                            month: 'long',                            : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300'

                            day: 'numeric'                        }`}>

                          })}                          {post.published ? 'Published' : 'Draft'}

                        </time>                        </span>

                      </div>                      </div>

                    </div>                    </div>

                    

                    {/* Title */}                    {post.content && (

                    <CardTitle className="line-clamp-2 group-hover:text-primary transition-colors">                      <p className="text-sm line-clamp-3">

                      <Link href={`/posts/${post.slug}`} className="hover:underline">                        {post.content}

                        {post.title}                      </p>

                      </Link>                    )}

                    </CardTitle>                    

                  </CardHeader>                    <div className="flex justify-between items-center pt-2 border-t text-xs text-muted-foreground">

                      <div className="flex items-center gap-2">

                  <CardContent className="flex-1 flex flex-col space-y-4">                        <span>

                    {/* Excerpt */}                          {new Date(post.createdAt).toLocaleDateString('vi-VN')}

                    <CardDescription className="line-clamp-3 flex-1">                        </span>

                      {post.excerpt || 'Nhấn để đọc thêm nội dung chi tiết...'}                        {post.published && (

                    </CardDescription>                          <>

                            <span>•</span>

                    {/* Footer */}                            <Link 

                    <div className="pt-4 border-t flex items-center justify-between">                              href={`/posts/${post.slug}`}

                      <div className="flex items-center gap-2 text-xs text-muted-foreground">                              className="text-primary hover:underline"

                        <User className="h-3 w-3" />                            >

