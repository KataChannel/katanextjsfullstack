                        </span>                          </>

                      </div>                        )}

                      <Button variant="ghost" size="sm" asChild>                      </div>

                        <Link href={`/posts/${post.slug}`}>                      <TogglePublishButton postId={post.id} published={post.published} />

                          Đọc thêm                    </div>

                          <ArrowRight className="ml-1 h-3 w-3" />                  </div>

                        </Link>                ))}

                      </Button>              </div>

                    </div>            )}

                  </CardContent>          </CardContent>

                </Card>        </Card>

              ))}      </div>

            </div>    </div>

          )}  )

        </div>}
      </section>

      {/* CTA Section */}
      {posts.length > 0 && (
        <section className="py-12 sm:py-16 bg-muted/30 border-t">
          <div className="container mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
            <h2 className="text-2xl sm:text-3xl font-bold">
