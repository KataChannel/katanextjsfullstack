  title: "Blog - Kiến thức làm đẹp",  title: "Quản lý bài viết",

  description: "Khám phá những bài viết hữu ích về làm đẹp, chăm sóc da và xu hướng thẩm mỹ mới nhất",  description: "Danh sách và quản lý tất cả bài viết trên website",

  ogType: "website",  ogType: "website",

});})



export default async function BlogListPage() {export default async function PostsPage() {

  const prisma = await getPrisma('tazagroup.vn');  const posts = await getPosts()

    const users = await getUsers()

